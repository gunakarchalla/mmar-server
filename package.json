{
  "name": "mmar-server",
  "version": "1.1.0",
  "description": "This the MMAR server for the MMAR project",
  "scripts": {
    "start": "npm run tjs && npm run swagger && npm run build && node ../dist/mmar-server/index.js",
    "debug": "nodemon",
    "docker:debug": "npm run tjs && npm run swagger && npm run build && nodemon",
    "build": "npm run build:global && npm run build:server",
    "build:server": "npm install && copyfiles \"package*.json\" \"../dist/mmar-server\" && npm install --prefix ../dist/mmar-server && tsc --build && npm run postbuild:server",
    "postbuild:server": "copyfiles \"config/**/*\" \"../dist/mmar-server\" && copyfiles \"views/**/*\" \"../dist/mmar-server\"",
    "build:global": "cd ../mmar-global-data-structure && npm run build",
    "test": "mocha --exit -r reflect-metadata -r ts-node/register test/unitTests/**/*.spec.ts",
    "swagger": "node ./config/swagger.mjs",
    "tjs": "node ./config/tjs.mjs",
    "test:unit": "mocha --exit -r reflect-metadata -r ts-node/register test/unitTests/Auth_middleware.spec.ts test/unitTests/Transaction_context.spec.ts test/unitTests/Security.spec.ts test/unitTests/Collection_difference.spec.ts",
    "lint": "eslint --ext .ts .",
    "lint:fix": "eslint --ext .ts . --fix",
    "test:reset": "node test/reset_test_database.js",
    "test:db": "npm run test:reset && npm test"
  },
  "nodemonConfig": {
    "watch": [
      "./"
    ],
    "ext": ".ts,.js",
    "ignore": [
      "./**/*.spec.ts"
    ],
    "exec": "ts-node ./index.ts"
  },
  "author": "Daniel Borcard & Fabian Muff & Gunakar Challa",
  "license": "AGPL-3.0",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "1.4.7",
    "copyfiles": "2.4.1",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "ejs": "3.1.10",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "7.2.0",
    "json-rules-engine": "7.3.1",
    "jsonpath-plus": "^10.4.0",
    "jsonwebtoken": "9.0.3",
    "multer": "1.4.5-lts.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "sharp": "^0.35.4",
    "source-map-support": "0.5.21",
    "swagger-autogen": "2.23.7",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "typescript-json-schema": "0.68.0",
    "uuid": "^11.1.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@stekoe/ocl.js": "1.7.0",
    "@types/bcrypt": "5.0.2",
    "@types/chai": "4.3.20",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/ejs": "3.1.5",
    "@types/express": "4.17.25",
    "@types/express-ejs-layouts": "2.5.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mocha": "10.0.10",
    "@types/multer": "1.4.13",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "chai": "4.5.0",
    "chai-http": "4.4.0",
    "eslint": "8.57.1",
    "mocha": "^11.8.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0",
    "diff": "^8.0.3"
  }
}
