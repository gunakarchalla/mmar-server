# -----------------------------------------------------------------------------
# MMAR API server configuration
#
# Copy this file to .env and fill in the values. .env is git-ignored and must
# stay that way: an earlier version of it was committed to this repository, so
# any value that ever appeared there has to be considered public.
#
# The server validates this file while it starts and refuses to boot on a bad
# configuration, rather than failing later on a request.
# -----------------------------------------------------------------------------

# --- Mandatory ---------------------------------------------------------------

# Secret used to sign and verify the JSON web tokens. At least 32 characters;
# the server will not start with a shorter one. Generate a fresh value with:
#   openssl rand -base64 48
JWT_SECRET=

# Password of the database role the server connects as.
PGPASSWORD=

# --- Database ----------------------------------------------------------------
# The defaults match the docker-compose service of the MMAR platform.

PGHOST=database
PGPORT=5432
PGUSER=api
PGDATABASE=api

# Connections held open by this process. One request uses one connection, so
# this only has to cover the requests in flight, and it must stay well below the
# database's own max_connections (100 by default) across all server instances.
PGPOOL_MAX=25
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECT_TIMEOUT_MS=10000

# Upper bound on a single query, so a runaway statement cannot pin a connection.
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=30000

# --- HTTP --------------------------------------------------------------------

HTTPPORT=8000

# "development" enables verbose logging. Anything else, including unset, is
# treated as a production deployment.
NODE_ENV=production

# Browser origins allowed to call the API, comma separated. The API accepts
# cookie authentication, so this cannot be left open to every origin. Leave it
# empty to allow same-origin requests only.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base url used to build the links returned for uploaded files. Falls back to
# the host of the incoming request when unset.
# PUBLIC_BASE_URL=https://mmar.example.org

# --- Tokens ------------------------------------------------------------------

# Lifetime of an issued token, in the notation accepted by jsonwebtoken
# ("30m", "8h", "7d") or a plain number of seconds. There is no revocation list,
# so this is also how long a leaked token stays usable.
TOKEN_EXPIRE_TIME=8h

# --- Audit -------------------------------------------------------------------

# Record successful token verifications in logging.t_security_event. That is one
# insert per authenticated API call, so it is off unless explicitly enabled.
# Sign ins, rejections and privilege changes are always recorded.
SECURITY_AUDIT_PERSIST_TOKEN_SUCCESS=false
